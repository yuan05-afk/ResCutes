# Neon Postgres (required for web + mobile data)
DATABASE_URL=

# Neon Auth (required for login on web + /mobile)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Mapbox public token (required for maps on dashboard + mobile home)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Vercel Blob (optional locally; recommended in production for report photos)
BLOB_READ_WRITE_TOKEN=

# Optional: public site URL (set automatically on Vercel as VERCEL_URL;
# configure the same hostname in Neon Auth trusted domains)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
