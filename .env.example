# Neon PostgreSQL (required)
DATABASE_URL=

# Neon Auth (required for login)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Mapbox public token (dashboard + mobile maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Vercel Blob (report / animal photo uploads; recommended in production)
BLOB_READ_WRITE_TOKEN=

# Optional: public site URL for absolute links / SEO
# NEXT_PUBLIC_SITE_URL=https://rescutes.vercel.app

# Optional: origin used when seeding Neon Auth users (defaults to http://localhost:3000)
# SEED_AUTH_ORIGIN=http://localhost:3000
